<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Clarion.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Clarion.App.Services">

    <Grid x:Name="Root" Background="{ThemeResource ClBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Background="{ThemeResource ClSidebarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" Padding="16,0,0,0" VerticalAlignment="Center">
                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{ThemeResource ClAccentBrush}" />
                <TextBlock Text="Clarion" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
            </StackPanel>
            <AutoSuggestBox x:Name="GlobalSearch" Grid.Column="2" Width="340" Height="32" Margin="0,4,0,4"
                            PlaceholderText="Search every setting" QueryIcon="Find"
                            AutomationProperties.Name="Search every setting"
                            QuerySubmitted="OnGlobalSearch" />
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="220"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
                        SelectionChanged="OnNavSelectionChanged" Background="Transparent">
            <NavigationView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#121820" />
                            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#121820" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#E9EDF2" />
                            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#E9EDF2" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Privacy" Tag="privacy">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Debloat" Tag="debloat">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE738;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Clean up" Tag="cleanup">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE74D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Repair" Tag="repair">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Tweaks" Tag="tweaks">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Power" Tag="power">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE945;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Network" Tag="network">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Windows features" Tag="features">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Updates" Tag="updates">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE895;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="System" Tag="system">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE770;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Report a problem" Tag="feedback">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8BD;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="What broke" Tag="troubleshoot">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9CE;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="VerifyItem" Content="Verify" Tag="verify">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE73E;" /></NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge><InfoBadge x:Name="VerifyBadge" Visibility="Collapsed" /></NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Safety" Tag="safety">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7EF;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <Border x:Name="ActivityPanel" Grid.Row="2" Visibility="Collapsed" Background="{ThemeResource ClSurface1Brush}"
                BorderBrush="{ThemeResource ClBorderBrush}" BorderThickness="0,1,0,0" Padding="24,14,24,14">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Activity.Title, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{ThemeResource ClTextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Activity.ProgressText, Mode=OneWay}"
                               Foreground="{ThemeResource ClTextSecondaryBrush}" VerticalAlignment="Center" />
                    <ProgressBar x:Name="ActivityBar" Grid.Column="2" VerticalAlignment="Center" MinWidth="120" />
                    <Button Grid.Column="3" Content="Open log" Click="OnOpenLog" />
                    <Button x:Name="ActivityHide" Grid.Column="4" Content="Hide" Click="OnHideActivity" />
                </Grid>
                <ScrollViewer x:Name="ActivityScroll" MaxHeight="190" Padding="0,0,14,0">
                    <ItemsControl ItemsSource="{x:Bind Activity.Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:ActivityLine">
                                <StackPanel Margin="0,2,0,2">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                                            <ProgressRing Width="14" Height="14" IsActive="True" Visibility="{x:Bind RunningVisibility, Mode=OneWay}" />
                                            <FontIcon FontSize="13" Glyph="{x:Bind Glyph, Mode=OneWay}" Foreground="{x:Bind GlyphBrush, Mode=OneWay}"
                                                      Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind Text}" FontFamily="Cascadia Mono" FontSize="12.5"
                                                   Foreground="{ThemeResource ClTextPrimaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Visibility="{x:Bind DetailVisibility, Mode=OneWay}"
                                               Margin="26,1,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource ClTextMutedBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Border x:Name="PendingBar" Grid.Row="3" Background="{ThemeResource ClSidebarBrush}"
                BorderBrush="{ThemeResource ClBorderBrush}" BorderThickness="0,1,0,0" Padding="24,12,24,12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ProgressRing x:Name="BusyRing" Width="18" Height="18" IsActive="False" />
                    <TextBlock x:Name="StatusText" Foreground="{ThemeResource ClTextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="0" HorizontalAlignment="Right" Content="Re-check"
                        ToolTipService.ToolTip="Read the current state of every setting again (F5)" Click="OnRefresh" Margin="0,0,12,0" />
                <Button x:Name="ClearButton" Grid.Column="1" Content="Clear queue" Click="OnClear" />
                <Button x:Name="ReviewButton" Grid.Column="2" Content="Review and apply"
                        Style="{StaticResource AccentButtonStyle}" Click="OnReview" />
            </Grid>
        </Border>
    </Grid>
</Window>
