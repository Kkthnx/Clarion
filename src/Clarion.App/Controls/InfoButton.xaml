<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Clarion.App.Controls.InfoButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clarion.App.Controls"
    IsTabStop="False">

    <!-- A circled i beside a row. Hover says what it is, and a click or Enter opens the full explanation next to it. -->
    <Button x:Name="Trigger" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="14"
            Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
            ToolTipService.ToolTip="What it does, what you gain and what could go wrong">
        <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource ClTextMutedBrush}" />
        <Button.Flyout>
            <Flyout x:Name="Popup" Opening="OnOpening">
                <controls:DetailPane x:Name="Pane" Bare="True" Width="440" MaxHeight="620" />
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
