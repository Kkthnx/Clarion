<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Clarion.App.Controls.AppMark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False" SizeChanged="OnSizeChanged">

    <!-- The brand logo when there is one, and otherwise a plain tile with the first letter, so every app has something to spot. -->
    <Grid>
        <Border x:Name="Tile" CornerRadius="8" BorderThickness="1" Visibility="Collapsed"
                Background="{ThemeResource ClSurface2Brush}" BorderBrush="{ThemeResource ClBorderBrush}">
            <TextBlock x:Name="Letter" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                       Foreground="{ThemeResource ClTextSecondaryBrush}" />
        </Border>
        <Path x:Name="Glyph" Stretch="Uniform" Visibility="Collapsed" />
    </Grid>
</UserControl>
