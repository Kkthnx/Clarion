<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Clarion.App.Controls.ReleaseTimeline"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clarion.App.Controls"
    xmlns:svc="using:Clarion.App.Services">

    <!-- A rail with one dot per release, and beside each dot a card that opens to show what changed, grouped. -->
    <ItemsControl x:Name="List">
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="svc:ReleaseVm">
                <Grid ColumnSpacing="14" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Rectangle Width="2" HorizontalAlignment="Center" Margin="0,30,0,-12" Fill="{ThemeResource ClBorderBrush}" />
                        <Ellipse Width="14" Height="14" VerticalAlignment="Top" Margin="0,19,0,0" StrokeThickness="2"
                                 Stroke="{ThemeResource ClOkBrush}" Fill="{ThemeResource ClOkBrush}" Visibility="{x:Bind IsInstalled}" />
                        <Ellipse Width="14" Height="14" VerticalAlignment="Top" Margin="0,19,0,0" StrokeThickness="2"
                                 Stroke="{ThemeResource ClAccentBrush}" Fill="{ThemeResource ClBaseBrush}" Visibility="{x:Bind IsNotInstalled}" />
                    </Grid>

                    <Expander Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="{x:Bind IsExpanded}"
                              Background="{ThemeResource ClSurface1Brush}" BorderBrush="{ThemeResource ClBorderBrush}" CornerRadius="8">
                        <Expander.Header>
                            <StackPanel Spacing="3" Padding="0,8,0,8">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{x:Bind Version}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{ThemeResource ClTextPrimaryBrush}" />
                                    <controls:Chip Text="{x:Bind BadgeText}" Kind="{x:Bind BadgeKind}" Visibility="{x:Bind ShowBadge}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Summary}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource ClTextMutedBrush}" />
                            </StackPanel>
                        </Expander.Header>

                        <StackPanel Spacing="12">
                            <ItemsControl ItemsSource="{x:Bind Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="svc:ChangeGroupVm">
                                        <Border Background="{ThemeResource ClSurface2Brush}" BorderBrush="{ThemeResource ClBorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="14,10,14,12" Margin="0,0,0,10">
                                            <StackPanel Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <controls:Chip Text="{x:Bind Title}" Kind="{x:Bind Kind}" />
                                                    <TextBlock Text="{x:Bind Count}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource ClTextMutedBrush}" />
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{x:Bind Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Grid ColumnSpacing="10" Margin="0,3,0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="&#x2022;" Foreground="{ThemeResource ClAccentBrush}" />
                                                                <TextBlock Grid.Column="1" Text="{x:Bind}" TextWrapping="Wrap" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="No notes were written for this release." Visibility="{x:Bind HasNoGroups}" Foreground="{ThemeResource ClTextSecondaryBrush}" />
                            <HyperlinkButton Content="Open this release on GitHub" Click="OnOpenRelease" Tag="{x:Bind Url}" Visibility="{x:Bind HasUrl}" Padding="0,2,0,2" />
                        </StackPanel>
                    </Expander>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
