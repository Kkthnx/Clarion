<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Clarion.App.Controls.Chip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colors come from visual states that use ThemeResource, so they follow the light and dark theme on their own. -->
    <Border x:Name="Root" CornerRadius="4" Padding="8,2,8,3" BorderThickness="1"
            Background="{ThemeResource ClSurface3Brush}" BorderBrush="{ThemeResource ClTextSecondaryBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Kinds">
                <VisualState x:Name="Neutral" />
                <VisualState x:Name="Accent">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource ClAccentTintBrush}" />
                        <Setter Target="Root.BorderBrush" Value="{ThemeResource ClAccentBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource ClAccentTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Cyan">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource ClCyanTintBrush}" />
                        <Setter Target="Root.BorderBrush" Value="{ThemeResource ClCyanBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource ClCyanTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Ok">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource ClOkTintBrush}" />
                        <Setter Target="Root.BorderBrush" Value="{ThemeResource ClOkBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource ClOkTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Warn">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource ClWarnTintBrush}" />
                        <Setter Target="Root.BorderBrush" Value="{ThemeResource ClWarnBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource ClWarnTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Danger">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource ClDangerTintBrush}" />
                        <Setter Target="Root.BorderBrush" Value="{ThemeResource ClDangerBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource ClDangerTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <TextBlock x:Name="Label" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ClTextSecondaryBrush}" />
    </Border>
</UserControl>
