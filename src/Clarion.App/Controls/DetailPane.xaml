<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Clarion.App.Controls.DetailPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clarion.App.Controls">

    <Border Background="{ThemeResource ClSurface1Brush}" BorderBrush="{ThemeResource ClBorderBrush}"
            BorderThickness="1" CornerRadius="8">
        <Grid>
            <!-- Nothing selected: a quiet, centred hint instead of text stuck in the corner. -->
            <StackPanel x:Name="EmptyPanel" Spacing="12" MaxWidth="260" Padding="20"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE946;" FontSize="28" Opacity="0.55" Foreground="{ThemeResource ClTextMutedBrush}" />
                <TextBlock x:Name="EmptyText" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource ClTextMutedBrush}" />
            </StackPanel>
            <ScrollViewer Padding="20,20,26,20">
                <StackPanel x:Name="Body" Spacing="16" Visibility="Collapsed">
                    <controls:TweakDetail x:Name="Detail" />
                    <TextBlock x:Name="ImageNoteText" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed"
                               Foreground="{ThemeResource ClTextSecondaryBrush}" />
                    <StackPanel x:Name="DeprovisionPanel" Spacing="4" Visibility="Collapsed">
                        <CheckBox x:Name="DeprovisionBox" Content="Also stop Windows installing it for new accounts"
                                  Checked="OnDeprovisionChanged" Unchecked="OnDeprovisionChanged" />
                        <TextBlock x:Name="DeprovisionNote" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource ClTextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
