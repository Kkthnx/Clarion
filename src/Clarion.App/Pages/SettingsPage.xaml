<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Clarion.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,24,32,24" Spacing="20" MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />

            <Border Background="{ThemeResource ClSurface1Brush}" BorderBrush="{ThemeResource ClBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <ToggleSwitch x:Name="ExpertSwitch" Header="Expert mode" OnContent="On" OffContent="Off" Toggled="OnExpertToggled" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                               Text="Shows Medium and High risk items, items with limited evidence, the exact registry values, services and commands behind every setting, and the source links." />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource ClSurface1Brush}" BorderBrush="{ThemeResource ClBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <ComboBox x:Name="ThemeBox" Header="Theme" SelectionChanged="OnThemeChanged" MinWidth="200">
                        <ComboBoxItem Content="Use my Windows setting" Tag="Default" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource ClSurface1Brush}" BorderBrush="{ThemeResource ClBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Your setup" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                               Text="Save the settings that are on right now to a small file, then load it on another PC or after a clean install. Loading only queues the settings, you review and apply them as usual. The same file works from the command line with Clarion.exe --apply file." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save my setup" Click="OnSaveSetup" />
                        <Button Content="Load a setup" Click="OnLoadSetup" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource ClSurface1Brush}" BorderBrush="{ThemeResource ClBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Updates" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                               Text="Clarion does not update itself. It can tell you when a newer version is on GitHub, and you decide whether to download it." />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="CheckUpdateButton" Content="Check for updates now" Click="OnCheckUpdate" />
                        <ProgressRing x:Name="UpdateBusy" Width="18" Height="18" IsActive="False" />
                        <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoUpdateSwitch" Header="Also check when Clarion starts" OnContent="On" OffContent="Off" Toggled="OnAutoUpdateToggled" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource ClTextMutedBrush}"
                               Text="Off unless you turn it on. When it is on, Clarion asks github.com for the list of Clarion releases at most once a day. That is an ordinary web request, so GitHub sees your IP address, as with any web page. Nothing else about you or your PC is sent." />
                </StackPanel>
            </Border>


            <Border Background="{ThemeResource ClSurface1Brush}" BorderBrush="{ThemeResource ClBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Monthly check" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                               Text="Windows updates are when settings most often get undone. This adds a Windows scheduled task that checks the settings Clarion applied on the second Wednesday of each month, the day after Windows' monthly updates. If the PC was off it checks at the next start. The next time you open Clarion, Home tells you what changed back." />
                    <ToggleSwitch x:Name="MonthlySwitch" Header="Check my settings every month" OnContent="On" OffContent="Off" Toggled="OnMonthlyToggled" />
                    <TextBlock x:Name="MonthlyStatus" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource ClTextMutedBrush}"
                               Text="The check only looks. It changes nothing and sends nothing anywhere. You can turn it off here, or delete the task called Monthly check in Task Scheduler." />
                </StackPanel>
            </Border>


            <Border Background="{ThemeResource ClSurface1Brush}" BorderBrush="{ThemeResource ClBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="About" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                    <TextBlock x:Name="VersionText" Foreground="{ThemeResource ClTextMutedBrush}" FontSize="12" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                               Text="Clarion has no telemetry and no account. It only goes onto the internet when you ask it to: the update check on this page, and links or problem reports you choose to open in your browser. Logs stay on this PC." />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <Button Content="Open log" Click="OnOpenLog" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
