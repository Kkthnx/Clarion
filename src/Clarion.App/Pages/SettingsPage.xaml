<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Clarion.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,24,32,24" Spacing="20" MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />

            <Border Background="{ThemeResource ClSurface1Brush}" BorderBrush="{ThemeResource ClBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <ToggleSwitch x:Name="ExpertSwitch" Header="Expert mode" OnContent="On" OffContent="Off" Toggled="OnExpertToggled" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                               Text="Shows Medium and High risk items, items with limited evidence, the exact registry values, services and commands behind every setting, and the source links." />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource ClSurface1Brush}" BorderBrush="{ThemeResource ClBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <ComboBox x:Name="ThemeBox" Header="Theme" SelectionChanged="OnThemeChanged" MinWidth="200">
                        <ComboBoxItem Content="Use my Windows setting" Tag="Default" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource ClSurface1Brush}" BorderBrush="{ThemeResource ClBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Your setup" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                               Text="Save the settings that are on right now to a small file, then load it on another PC or after a clean install. Loading only queues the settings, you review and apply them as usual. The same file works from the command line with Clarion.exe --apply file." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save my setup" Click="OnSaveSetup" />
                        <Button Content="Load a setup" Click="OnLoadSetup" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource ClSurface1Brush}" BorderBrush="{ThemeResource ClBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="About" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                    <TextBlock x:Name="VersionText" Foreground="{ThemeResource ClTextMutedBrush}" FontSize="12" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                               Text="Clarion has no telemetry and sends nothing anywhere. Logs stay on this PC. To report a problem or suggest something, use Report a problem in the sidebar. Source links in Expert mode open in your browser." />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <Button Content="Open log" Click="OnOpenLog" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
