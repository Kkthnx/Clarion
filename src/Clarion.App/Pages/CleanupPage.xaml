<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Clarion.App.Pages.CleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clarion.App.Controls"
    xmlns:pages="using:Clarion.App.Pages"
    xmlns:svc="using:Clarion.App.Services">

    <Grid Padding="32,24,32,16" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Clean up" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                       Text="See what is taking space, then clear only what you choose. Nothing is deleted until you press Clean, and only files that Windows or your games rebuild by themselves are touched." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ScanButton" Content="Scan" Click="OnScan" />
            <Button x:Name="SuggestButton" Grid.Column="1" Content="Select suggested" Click="OnSelectSuggested" />
            <ToggleSwitch x:Name="PreviewSwitch" Grid.Column="2" OnContent="Preview only" OffContent="Preview only"
                          ToolTipService.ToolTip="Measure what would be removed and delete nothing" MinWidth="0" />
            <Button x:Name="CleanButton" Grid.Column="3" Content="Clean selected" Style="{StaticResource AccentButtonStyle}" Click="OnClean" />
            <Button x:Name="StopButton" Grid.Column="4" Content="Stop" Click="OnStop" Visibility="Collapsed" />
            <StackPanel Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="StatusLabel" HorizontalAlignment="Right" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                <TextBlock x:Name="SelectedText" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource ClTextMutedBrush}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="8">
            <Border x:Name="ProgressPanel" Visibility="Collapsed" Background="{ThemeResource ClSurface1Brush}"
                    BorderBrush="{ThemeResource ClBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12,16,12">
                <StackPanel Spacing="6">
                    <ProgressBar IsIndeterminate="True" />
                    <TextBlock x:Name="LiveText" Foreground="{ThemeResource ClCyanBrush}" FontWeight="SemiBold" />
                    <TextBlock x:Name="FileText" FontSize="12" FontFamily="Cascadia Mono" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource ClTextMutedBrush}" />
                </StackPanel>
            </Border>
            <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" Severity="Success" />
            <InfoBar x:Name="QueueBar" IsOpen="False" IsClosable="False" Severity="Informational" />
            <StackPanel x:Name="RestartRow" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                <Button x:Name="RestartButton" Content="Restart now" Click="OnRestart" />
                <Button x:Name="CancelRestartButton" Content="Cancel restart" Click="OnCancelRestart" Visibility="Collapsed" />
                <Button Content="Copy report" Click="OnCopyReport" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="3" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <ScrollViewer>
                <ItemsControl x:Name="Groups">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pages:CleanupGroup">
                            <StackPanel Spacing="8" Margin="0,0,0,18">
                                <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                                <ItemsControl ItemsSource="{x:Bind Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="svc:CleanupItem">
                                            <Border Tag="{x:Bind}" Tapped="OnCardTapped" Margin="0,0,0,8" CornerRadius="8" Padding="14,10,14,10"
                                                    Background="{ThemeResource ClSurface1Brush}" BorderBrush="{ThemeResource ClBorderBrush}" BorderThickness="1">
                                                <ToolTipService.ToolTip>
                                                    <ToolTip MaxWidth="440" Padding="16" Opened="OnTipOpened" Tag="{x:Bind}"
                                                             Background="{ThemeResource ClSurface2Brush}" BorderBrush="{ThemeResource ClBorderBrush}">
                                                        <TextBlock Text="Loading" Width="400" />
                                                    </ToolTip>
                                                </ToolTipService.ToolTip>
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{x:Bind CheckedBinding, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect, Mode=OneWay}"
                                                              AutomationProperties.Name="{x:Bind Name}" MinWidth="0" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                                                        <TextBlock Text="{x:Bind Summary}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                                            <controls:Chip Text="{x:Bind RecommendationText}" Kind="{x:Bind RecommendationKind}" />
                                                            <controls:Chip Text="{x:Bind RiskText}" Kind="{x:Bind RiskKind}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource ClTextMutedBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" Foreground="{ThemeResource ClCyanBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <controls:DetailPane x:Name="Pane" Grid.Column="1" TechnicalTitle="Exact folders" EmptyMessage="Select a row to see what it is, what it frees, and the exact folders it touches." />
        </Grid>
    </Grid>
</Page>
