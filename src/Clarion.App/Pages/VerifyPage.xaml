<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Clarion.App.Pages.VerifyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Clarion.App.Pages">

    <Page.Resources>
        <DataTemplate x:Key="DriftRowTemplate" x:DataType="svc:DriftRow">
            <Border Background="{ThemeResource ClSurface1Brush}" BorderBrush="{ThemeResource ClBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12,16,12" Margin="0,0,0,8">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                        <TextBlock Text="{x:Bind When}" FontSize="12" Foreground="{ThemeResource ClTextMutedBrush}" />
                        <TextBlock Text="{x:Bind Detail}" FontSize="12" TextWrapping="Wrap" FontFamily="Cascadia Mono"
                                   Foreground="{ThemeResource ClTextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="{x:Bind FixLabel}" Click="OnFixOne" Tag="{x:Bind TweakId}" />
                        <Button Content="That was me" Click="OnLeaveOne" Tag="{x:Bind TweakId}"
                                ToolTipService.ToolTip="You changed it on purpose, for example by reinstalling an app or turning something back on. Clarion stops checking it and changes nothing in Windows. You can start checking it again from the list at the bottom." />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32,24,32,24" Spacing="20" MaxWidth="1000" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Verify" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                           Text="Checks everything Clarion applied against Windows as it is now. Windows updates, and sometimes you, can undo a change or bring a removed app back." />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="ScanButton" Content="Scan now" Click="OnScan" Style="{StaticResource AccentButtonStyle}" />
                <ProgressRing x:Name="Busy" Width="20" Height="20" IsActive="False" />
                <ProgressBar x:Name="ScanBar" Width="220" VerticalAlignment="Center" Minimum="0" Maximum="1" Value="0" Visibility="Collapsed" />
                <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Foreground="{ThemeResource ClTextSecondaryBrush}" />
            </StackPanel>

            <InfoBar x:Name="RestartBar" Visibility="Collapsed" Severity="Informational" IsOpen="False" IsClosable="False" Title="Windows is waiting for a restart" />
            <InfoBar x:Name="UpdateBar" Visibility="Collapsed" Severity="Informational" IsOpen="False" IsClosable="False" Title="Windows was updated" />
            <InfoBar x:Name="UnreadableBar" Visibility="Collapsed" Severity="Warning" IsOpen="False" IsClosable="False" Title="Some settings could not be read" />

            <Border x:Name="AllGoodText" Visibility="Collapsed" CornerRadius="8" Padding="20,16,20,16" BorderThickness="1"
                    Background="{ThemeResource ClSurface1Brush}" BorderBrush="{ThemeResource ClOkBrush}">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <FontIcon Glyph="&#xE73E;" FontSize="22" Foreground="{ThemeResource ClOkTextBrush}" VerticalAlignment="Center" />
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Everything is still in place" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                        <TextBlock Text="Every setting Clarion applied matches what Windows has now." Foreground="{ThemeResource ClTextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="NothingCard" Visibility="Collapsed" CornerRadius="8" Padding="20,28,20,28" BorderThickness="1"
                    Background="{ThemeResource ClSurface1Brush}" BorderBrush="{ThemeResource ClBorderBrush}">
                <StackPanel Spacing="10" HorizontalAlignment="Center" MaxWidth="520">
                    <FontIcon Glyph="&#xE73E;" FontSize="30" Opacity="0.55" Foreground="{ThemeResource ClTextMutedBrush}" />
                    <TextBlock Text="Nothing to check yet" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource ClTextSecondaryBrush}"
                               Text="Once you apply a setting, Clarion checks it here, and again after Windows updates, which is when changes are most likely to be undone." />
                </StackPanel>
            </Border>

            <StackPanel x:Name="AppsSection" Spacing="10" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Apps that came back" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{ThemeResource ClTextPrimaryBrush}" />
                    <Button Content="Remove them all again" Click="OnFixApps" />
                </StackPanel>
                <ItemsControl x:Name="AppRows" ItemTemplate="{StaticResource DriftRowTemplate}" />
            </StackPanel>

            <StackPanel x:Name="SettingsSection" Spacing="10" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Settings changed back" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{ThemeResource ClTextPrimaryBrush}" />
                    <Button Content="Put them all back" Click="OnFixSettings" />
                </StackPanel>
                <ItemsControl x:Name="SettingRows" ItemTemplate="{StaticResource DriftRowTemplate}" />
            </StackPanel>

            <StackPanel x:Name="StoppedSection" Spacing="10" Visibility="Collapsed">
                <TextBlock Text="Stopped checking" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                           Text="You told Clarion these were your own changes. It does not check them. Watch again if you want it to." />
                <ItemsControl x:Name="StoppedRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="svc:StoppedRow">
                            <Border Background="{ThemeResource ClSurface1Brush}" BorderBrush="{ThemeResource ClBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16,10,16,10" Margin="0,0,0,8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind When}" FontSize="12" Foreground="{ThemeResource ClTextMutedBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Watch again" Click="OnWatchAgain" Tag="{x:Bind TweakId}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
