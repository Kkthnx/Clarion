<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Clarion.App.Pages.RepairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clarion.App.Controls"
    xmlns:pages="using:Clarion.App.Pages"
    xmlns:svc="using:Clarion.App.Services">

    <Grid Padding="32,24,32,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Repair and maintenance" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                       Text="One time jobs that fix common problems. Each one uses the tools that ship with Windows, shows its output while it runs, and can be stopped." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <ScrollViewer>
                <ItemsControl x:Name="Groups">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pages:RepairGroup">
                            <StackPanel Spacing="8" Margin="0,0,0,18">
                                <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                                <ItemsControl ItemsSource="{x:Bind Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="svc:ActionItem">
                                            <Border Tag="{x:Bind}" Tapped="OnCardTapped" Margin="0,0,0,8" CornerRadius="8" Padding="16,12,16,12"
                                                    Background="{ThemeResource ClSurface1Brush}" BorderBrush="{ThemeResource ClBorderBrush}" BorderThickness="1">
                                                <ToolTipService.ToolTip>
                                                    <ToolTip MaxWidth="440" Padding="16" Opened="OnTipOpened" Tag="{x:Bind}"
                                                             Background="{ThemeResource ClSurface2Brush}" BorderBrush="{ThemeResource ClBorderBrush}">
                                                        <TextBlock Text="Loading" Width="400" />
                                                    </ToolTip>
                                                </ToolTipService.ToolTip>
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                                                        <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                                            <controls:Chip Text="{x:Bind RecommendationText}" Kind="{x:Bind RecommendationKind}" />
                                                            <controls:Chip Text="{x:Bind RiskText}" Kind="{x:Bind RiskKind}" />
                                                            <controls:Chip Text="{x:Bind DurationText}" Kind="Neutral" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Run" VerticalAlignment="Center" Tag="{x:Bind}" Click="OnRun"
                                                            AutomationProperties.Name="{x:Bind Name}" MinWidth="72" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <controls:DetailPane x:Name="Pane" Grid.Column="1" TechnicalTitle="Exact commands" EmptyMessage="Select a job to see what it does, how long it takes, and the exact commands it runs." />
        </Grid>
    </Grid>
</Page>
