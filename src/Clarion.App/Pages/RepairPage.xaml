<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Clarion.App.Pages.RepairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clarion.App.Controls"
    xmlns:pages="using:Clarion.App.Pages"
    xmlns:svc="using:Clarion.App.Services">

    <Grid Padding="32,24,32,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Repair and maintenance" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                       Text="One time jobs that fix common problems. Each one uses the tools that ship with Windows, shows its output while it runs, and can be stopped." />
        </StackPanel>

        <Grid Grid.Row="1">
            <ScrollViewer Padding="0,0,14,0">
                <StackPanel>
                <ItemsControl x:Name="Groups">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pages:RepairGroup">
                            <StackPanel Spacing="8" Margin="0,0,0,18">
                                <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                                <ListView ItemsSource="{x:Bind Items}" SelectionMode="None"
                                          IsItemClickEnabled="False" ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                          ItemContainerStyle="{StaticResource CardListViewItemStyle}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="svc:ActionItem">
                                            <Border Padding="18,12,16,12">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="4">
                                                        <Grid ColumnSpacing="4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                                                            <controls:InfoButton Grid.Column="1" Item="{x:Bind}" AlwaysTechnical="True" TechnicalTitle="Exact commands"
                                                                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-3,0,-3" />
                                                        </Grid>
                                                        <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                                            <controls:Chip Text="{x:Bind RecommendationText}" Kind="{x:Bind RecommendationKind}"
                                                       ToolTipService.ToolTip="{x:Bind RecommendationHint}" />
                                                            <controls:Chip Text="{x:Bind RiskText}" Kind="{x:Bind RiskKind}"
                                                       ToolTipService.ToolTip="{x:Bind RiskHint}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind DurationText}" FontSize="12" Foreground="{ThemeResource ClTextMutedBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Run" VerticalAlignment="Center" Tag="{x:Bind}" Click="OnRun"
                                                            AutomationProperties.Name="{x:Bind Name}" MinWidth="72" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Spacing="8" Margin="0,0,0,18">
                    <TextBlock Text="Windows tools" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                               Text="Shortcuts to the classic tools that Windows 11 still sends you to. They only open the Windows window. Nothing is changed by opening one." />
                    <controls:WrapPanel x:Name="ToolButtons" HorizontalSpacing="8" VerticalSpacing="8" />
                </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
