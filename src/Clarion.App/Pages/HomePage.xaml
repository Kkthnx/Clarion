<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Clarion.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clarion.App.Controls"
    xmlns:svc="using:Clarion.App.Services">

    <ScrollViewer>
        <StackPanel Padding="32,24,32,24" Spacing="24" MaxWidth="1100" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="18">
                <Image Source="ms-appx:///Assets/Clarion.png" Width="72" Height="72" VerticalAlignment="Center" />
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Clarion" FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                        <Border VerticalAlignment="Center" Padding="8,2,8,2" CornerRadius="10" BorderThickness="1"
                                Background="{ThemeResource ClAccentTintBrush}" BorderBrush="{ThemeResource ClAccentBrush}">
                            <TextBlock Text="{x:Bind svc:AppServices.Version}" FontSize="12" Foreground="{ThemeResource ClAccentTextBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="See it. Set it. Done." FontSize="16" Foreground="{ThemeResource ClAccentTextBrush}" />
                </StackPanel>
            </StackPanel>

            <InfoBar x:Name="AccountBar" Visibility="Collapsed" Severity="Warning" IsOpen="False" IsClosable="False"
                     Title="Clarion is running as a different account" />

            <InfoBar x:Name="LimitedBar" Visibility="Collapsed" Severity="Warning" IsOpen="False" IsClosable="False"
                     Title="Clarion is running without administrator rights"
                     Message="You can look at your settings and run Verify. Changing anything needs administrator rights, because Clarion keeps its history in a folder only administrators can write to.">
                <InfoBar.ActionButton>
                    <Button Content="Restart as administrator" Click="OnRestartAsAdmin" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar x:Name="MovedBar" Visibility="Collapsed" Severity="Warning" IsOpen="False" IsClosable="False"
                     Title="The monthly check starts a different copy of Clarion"
                     Message="It was set up from another folder, so it may not run. Set it up again from this copy to fix it.">
                <InfoBar.ActionButton>
                    <Button Content="Fix it" Click="OnFixMonthly" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar x:Name="UpdatedBar" Visibility="Collapsed" Severity="Success" IsOpen="False" IsClosable="True" Closed="OnUpdatedClosed">
                <InfoBar.ActionButton>
                    <Button Content="See what's new" Click="OnSeeWhatsNew" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar x:Name="UpdateBar" Visibility="Collapsed" Severity="Success" IsOpen="False" IsClosable="False">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="See what changed" Click="OnSeeWhatsNew" />
                    <HyperlinkButton Content="Open the release page" Click="OnOpenUpdate" />
                    <HyperlinkButton Content="Hide this version" Click="OnHideUpdate" />
                </StackPanel>
            </InfoBar>

            <InfoBar x:Name="ScheduledBar" Visibility="Collapsed" Severity="Warning" IsOpen="False" IsClosable="False"
                     Title="The monthly check found changes">
                <InfoBar.ActionButton>
                    <Button Content="Review" Click="OnReviewScheduled" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar x:Name="DriftBar" Visibility="Collapsed" Severity="Warning" IsOpen="False" IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="Review" Click="OnReviewDrift" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar x:Name="RestartBar" Visibility="Collapsed" Severity="Informational" IsOpen="False" IsClosable="False"
                     Title="Windows is waiting for a restart">
                <InfoBar.ActionButton>
                    <Button Content="See what will be checked" Click="OnReviewDrift" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar x:Name="ImageBar" Visibility="Collapsed" Severity="Informational" IsOpen="False" IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="See why" Click="OnSeeImage" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- This PC at a glance. The hardware tiles fill in when the system report has been read. -->
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:InfoTile x:Name="WindowsTile" Glyph="&#xE770;" Title="Windows" Kind="Accent" />
                <controls:InfoTile x:Name="CpuTile" Grid.Column="1" Glyph="&#xE950;" Title="Processor" Kind="Cyan" />
                <controls:InfoTile x:Name="MemoryTile" Grid.Column="2" Glyph="&#xEEA1;" Title="Memory" Kind="Ok" />
                <controls:InfoTile x:Name="GraphicsTile" Grid.Row="1" Glyph="&#xE7F4;" Title="Graphics" Kind="Warn" />
                <controls:InfoTile x:Name="StorageTile" Grid.Row="1" Grid.Column="1" Glyph="&#xEDA2;" Title="Storage" Kind="Accent" />
                <controls:InfoTile x:Name="ClarionTile" Grid.Row="1" Grid.Column="2" Glyph="&#xE73E;" Title="Settings in effect" Kind="Cyan" />
            </Grid>


            <StackPanel Spacing="4">
                <TextBlock Text="Start with a preset" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                           Text="A preset queues a group of settings. Nothing changes until you review and press Apply at the bottom." />
            </StackPanel>

            <ItemsControl x:Name="PresetList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Border Background="{ThemeResource ClAccentTintBrush}" BorderBrush="{ThemeResource ClAccentBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Your safety net" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                               Text="Clarion makes a System Restore point before every batch, records the exact value it replaced, and can revert any single setting from the Safety page." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
