<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Clarion.App.Pages.TweakListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clarion.App.Controls"
    xmlns:svc="using:Clarion.App.Services">

    <Grid Padding="32,24,32,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold"
                       Foreground="{ThemeResource ClTextPrimaryBrush}" />
            <TextBlock x:Name="SubtitleText" TextWrapping="Wrap"
                       Foreground="{ThemeResource ClTextSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" MinWidth="150" MaxWidth="300" />
                <ColumnDefinition Width="1*" MinWidth="120" MaxWidth="170" />
                <ColumnDefinition Width="1.2*" MinWidth="130" MaxWidth="210" />
                <ColumnDefinition Width="Auto" MinWidth="90" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search settings" QueryIcon="Find"
                            AutomationProperties.Name="Search settings on this page"
                            TextChanged="OnSearchTextChanged" />
            <ComboBox x:Name="FilterBox" Grid.Column="1" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Filter settings" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="All settings" Tag="all" IsSelected="True" />
                <ComboBoxItem Content="Suggested" Tag="suggested" />
                <ComboBoxItem Content="Currently on" Tag="on" />
                <ComboBoxItem Content="Currently off" Tag="off" />
                <ComboBoxItem Content="Needs attention" Tag="attention" />
            </ComboBox>
            <ComboBox x:Name="TopicBox" Grid.Column="2" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Filter by topic" SelectionChanged="OnTopicChanged" />
            <TextBlock x:Name="CountText" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="NoWrap"
                       Foreground="{ThemeResource ClTextMutedBrush}" />
        </Grid>

        <controls:DnsChooser x:Name="Chooser" Grid.Row="2" Visibility="Collapsed" />

        <Grid Grid.Row="3" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="1.05*" MinWidth="280" MaxWidth="400" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="List" Padding="0,0,14,0" SelectionMode="Single" SelectionChanged="OnSelectionChanged"
                      IsItemClickEnabled="False" ItemsSource="{x:Bind Visible}"
                      ItemContainerStyle="{StaticResource CardListViewItemStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="svc:TweakItem">
                        <Border Padding="18,14,16,14">
                            <ToolTipService.ToolTip>
                                <ToolTip MaxWidth="440" Padding="16" Opened="OnTipOpened" Tag="{x:Bind}"
                                         Background="{ThemeResource ClSurface2Brush}"
                                         BorderBrush="{ThemeResource ClBorderBrush}">
                                    <TextBlock Text="Loading" Width="400" />
                                </ToolTip>
                            </ToolTipService.ToolTip>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource ClTextSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                        <controls:Chip Text="{x:Bind RecommendationText}" Kind="{x:Bind RecommendationKind}" />
                                        <controls:Chip Text="{x:Bind RiskText}" Kind="{x:Bind RiskKind}" />
                                        <controls:Chip Text="{x:Bind PendingText, Mode=OneWay}" Kind="Accent"
                                                       Visibility="{x:Bind IsPending, Mode=OneWay}" />
                                        <controls:Chip Text="Changed back by Windows" Kind="Warn"
                                                       Visibility="{x:Bind IsDrifted, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                Visibility="{x:Bind HasLastError, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE783;" FontSize="12" Foreground="{ThemeResource ClDangerTextBrush}" />
                                        <TextBlock Text="{x:Bind LastError, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{ThemeResource ClDangerTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind IsLocked}">
                                        <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource ClTextMutedBrush}" />
                                        <TextBlock Text="{x:Bind LockReason}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{ThemeResource ClTextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" HorizontalAlignment="Right">
                                    <ToggleSwitch IsOn="{x:Bind IsOn, Mode=TwoWay}" IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                                  AutomationProperties.Name="{x:Bind Name}"
                                                  OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" />
                                    <TextBlock Text="{x:Bind StateText, Mode=OneWay}" FontSize="12" HorizontalAlignment="Right"
                                               Foreground="{ThemeResource ClTextMutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <controls:DetailPane x:Name="Pane" Grid.Column="1" EmptyMessage="Select a setting to see what it does, what you gain, and what could go wrong." />
        </Grid>
    </Grid>
</Page>
