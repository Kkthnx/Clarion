<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Clarion.App.Pages.TweakListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clarion.App.Controls"
    xmlns:svc="using:Clarion.App.Services">
    <Page.Resources>
        <!-- The same card, for a row that holds two. The row carries no card of its own, so each side draws its own. -->
        <Style x:Key="PairCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource ClSurface1Brush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ClBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="PairRowItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The roomy row: the summary is shown under the name. -->
        <DataTemplate x:Key="RoomyRow" x:DataType="svc:TweakItem">
                        <Border Padding="18,14,16,14" Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                          <Grid>
                            <!-- For an app, its logo faded far back behind the card, behind the switch, so it never sits under the text. -->
                            <controls:AppMark Icon="{x:Bind Icon}" Label="{x:Bind Name}" IsWatermark="True" Width="84" Height="84"
                                              Opacity="0.07" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,6,0" Visibility="{x:Bind IsApp}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <!-- A fixed width, so the state text changing from "Checking" to "On" cannot change how the name wraps. -->
                                    <ColumnDefinition Width="84" />
                                </Grid.ColumnDefinitions>
                                <controls:AppMark Icon="{x:Bind Icon}" ImagePath="{x:Bind InstalledIconPath, Mode=OneWay}" LogoFile="{x:Bind LogoFilePath}" Label="{x:Bind Name}" Width="36" Height="36" Margin="0,0,16,0"
                                                  VerticalAlignment="Top" Visibility="{x:Bind IsApp}" />
                                <StackPanel Grid.Column="1" Spacing="6" Margin="0,0,16,0">
                                    <!-- The i sits right after the name, which takes only the room it needs. -->
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                                        <controls:InfoButton Grid.Column="1" Item="{x:Bind}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-3,0,-3" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource ClTextSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                        <controls:Chip Text="{x:Bind RecommendationText}" Kind="{x:Bind RecommendationKind}" Visibility="{x:Bind ShowRecommendation}"
                                                       ToolTipService.ToolTip="{x:Bind RecommendationHint}" />
                                        <controls:Chip Text="{x:Bind RiskText}" Kind="{x:Bind RiskKind}"
                                                       ToolTipService.ToolTip="{x:Bind RiskHint}" />
                                        <controls:Chip Text="{x:Bind PendingText, Mode=OneWay}" Kind="Accent"
                                                       Visibility="{x:Bind IsPending, Mode=OneWay}" />
                                        <controls:Chip Text="Changed back by Windows" Kind="Warn"
                                                       Visibility="{x:Bind IsDrifted, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                Visibility="{x:Bind HasLastError, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE783;" FontSize="12" Foreground="{ThemeResource ClDangerTextBrush}" />
                                        <TextBlock Text="{x:Bind LastError, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{ThemeResource ClDangerTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind IsLocked}">
                                        <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource ClTextMutedBrush}" />
                                        <TextBlock Text="{x:Bind LockReason}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{ThemeResource ClTextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4" HorizontalAlignment="Right">
                                    <ToggleSwitch IsOn="{x:Bind IsOn, Mode=TwoWay}" IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                                  AutomationProperties.Name="{x:Bind Name}"
                                                  OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" />
                                    <TextBlock Text="{x:Bind StateText, Mode=OneWay}" FontSize="12" HorizontalAlignment="Right"
                                               TextWrapping="Wrap" TextAlignment="Right"
                                               Foreground="{ThemeResource ClTextMutedBrush}" />
                                </StackPanel>
                            </Grid>
                          </Grid>
                        </Border>
                    </DataTemplate>
        <DataTemplate x:Key="TwoColumnRow" x:DataType="svc:CardRow">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource PairCardStyle}" PointerEntered="OnCardEntered" PointerExited="OnCardExited">
                    <ContentControl Content="{x:Bind First}" ContentTemplate="{StaticResource RoomyRow}" HorizontalContentAlignment="Stretch" />
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PairCardStyle}" Visibility="{x:Bind HasSecond}"
                        PointerEntered="OnCardEntered" PointerExited="OnCardExited">
                    <ContentControl Content="{x:Bind Second}" ContentTemplate="{StaticResource RoomyRow}" HorizontalContentAlignment="Stretch" />
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ThreeColumnRow" x:DataType="svc:CardRow">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource PairCardStyle}" PointerEntered="OnCardEntered" PointerExited="OnCardExited">
                    <ContentControl Content="{x:Bind First}" ContentTemplate="{StaticResource RoomyRow}" HorizontalContentAlignment="Stretch" />
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PairCardStyle}" Visibility="{x:Bind HasSecond}"
                        PointerEntered="OnCardEntered" PointerExited="OnCardExited">
                    <ContentControl Content="{x:Bind Second}" ContentTemplate="{StaticResource RoomyRow}" HorizontalContentAlignment="Stretch" />
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PairCardStyle}" Visibility="{x:Bind HasThird}"
                        PointerEntered="OnCardEntered" PointerExited="OnCardExited">
                    <ContentControl Content="{x:Bind Third}" ContentTemplate="{StaticResource RoomyRow}" HorizontalContentAlignment="Stretch" />
                </Border>
            </Grid>
        </DataTemplate>        <!-- One line per setting, for scanning a long list. The summary and the detail are under the i. -->
        <DataTemplate x:Key="CompactRow" x:DataType="svc:TweakItem">
            <Border Padding="14,5,10,5" Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:AppMark Icon="{x:Bind Icon}" ImagePath="{x:Bind InstalledIconPath, Mode=OneWay}" LogoFile="{x:Bind LogoFilePath}" Label="{x:Bind Name}" Width="22" Height="22" Margin="0,0,10,0"
                                      VerticalAlignment="Center" Visibility="{x:Bind IsApp}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="10,0,10,0" VerticalAlignment="Center">
                        <controls:Chip Text="{x:Bind RecommendationShort}" Kind="{x:Bind RecommendationKind}" Visibility="{x:Bind ShowRecommendation}" ToolTipService.ToolTip="{x:Bind RecommendationHint}" />
                        <controls:Chip Text="{x:Bind RiskText}" Kind="{x:Bind RiskKind}" Visibility="{x:Bind RiskIsNotable}"
                                  ToolTipService.ToolTip="{x:Bind RiskHint}" />
                        <controls:Chip Text="{x:Bind PendingText, Mode=OneWay}" Kind="Accent" Visibility="{x:Bind IsPending, Mode=OneWay}" />
                        <controls:Chip Text="Changed back" Kind="Warn" Visibility="{x:Bind IsDrifted, Mode=OneWay}" />
                        <FontIcon Glyph="&#xE783;" FontSize="13" Foreground="{ThemeResource ClDangerTextBrush}"
                                  Visibility="{x:Bind HasLastError, Mode=OneWay}"
                                  ToolTipService.ToolTip="{x:Bind LastError, Mode=OneWay}" />
                        <FontIcon Glyph="&#xE72E;" FontSize="13" Foreground="{ThemeResource ClTextMutedBrush}"
                                  Visibility="{x:Bind IsLocked}" ToolTipService.ToolTip="{x:Bind LockReason}" />
                    </StackPanel>
                    <controls:InfoButton Grid.Column="3" Item="{x:Bind}" Margin="0,-6,6,-6" />
                    <ToggleSwitch Grid.Column="4" IsOn="{x:Bind IsOn, Mode=TwoWay}" IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                  AutomationProperties.Name="{x:Bind Name}" OnContent="" OffContent="" MinWidth="0" MinHeight="0" Margin="0,-6,0,-6" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32,24,32,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold"
                       Foreground="{ThemeResource ClTextPrimaryBrush}" />
            <TextBlock x:Name="SubtitleText" TextWrapping="Wrap"
                       Foreground="{ThemeResource ClTextSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="10">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" MinWidth="150" MaxWidth="340" />
                <ColumnDefinition Width="1*" MinWidth="120" MaxWidth="190" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="90" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search settings" QueryIcon="Find"
                            AutomationProperties.Name="Search settings on this page"
                            TextChanged="OnSearchTextChanged" />
            <ComboBox x:Name="FilterBox" Grid.Column="1" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Filter settings" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="All settings" Tag="all" IsSelected="True" />
                <ComboBoxItem Content="Suggested" Tag="suggested" />
                <ComboBoxItem Content="Currently on" Tag="on" />
                <ComboBoxItem Content="Currently off" Tag="off" />
                <ComboBoxItem Content="Can be changed here" Tag="available" />
                <ComboBoxItem Content="Needs attention" Tag="attention" />
            </ComboBox>
            <ToggleButton x:Name="CompactToggle" Grid.Column="2" Content="Compact" VerticalAlignment="Stretch"
                          AutomationProperties.Name="Compact list"
                          ToolTipService.ToolTip="One line per setting, so more fit on screen. The details are under the i beside each one."
                          Click="OnCompactClicked" />
            <TextBlock x:Name="CountText" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="NoWrap"
                       Foreground="{ThemeResource ClTextMutedBrush}" />
        </Grid>
        <controls:WrapPanel x:Name="TopicPills" Visibility="Collapsed" HorizontalSpacing="6" VerticalSpacing="6" />
        </StackPanel>

        <controls:DnsChooser x:Name="Chooser" Grid.Row="2" Visibility="Collapsed" />

        <ListView x:Name="List" Grid.Row="3" Padding="0,0,14,0" SelectionMode="None" SizeChanged="OnListSizeChanged"
                  IsItemClickEnabled="False"
                  ItemTemplate="{StaticResource RoomyRow}" ItemContainerStyle="{StaticResource CardListViewItemStyle}" />
    </Grid>
</Page>
