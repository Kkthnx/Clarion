<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Clarion.App.Pages.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clarion.App.Controls"
    xmlns:pages="using:Clarion.App.Pages">
    <Page.Resources>
        <DataTemplate x:Key="StartupRowTemplate" x:DataType="pages:StartupRowItem">
            <Border Background="{ThemeResource ClSurface1Brush}" BorderBrush="{ThemeResource ClBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12,16,12" Margin="0,0,0,8"
                    AutomationProperties.Name="{x:Bind Title}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                        <TextBlock Text="{x:Bind Subtitle}" FontSize="12" TextWrapping="Wrap" Visibility="{x:Bind SubtitleVisible}"
                                   Foreground="{ThemeResource ClTextSecondaryBrush}" />
                        <TextBlock Text="{x:Bind Command}" FontFamily="Cascadia Mono" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource ClTextMutedBrush}" />
                        <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" Margin="0,8,0,0">
                            <controls:Chip Text="{x:Bind Source}" Kind="Neutral" ToolTipService.ToolTip="{x:Bind SourceTip}" />
                            <controls:Chip Text="{x:Bind OffText}" Kind="Accent" Visibility="{x:Bind OffVisible}"
                                           ToolTipService.ToolTip="Turned off in the list Task Manager's Startup tab reads" />
                        </controls:WrapPanel>
                        <TextBlock Text="{x:Bind Warning}" FontSize="12" TextWrapping="Wrap" Visibility="{x:Bind WarningVisible}"
                                   Foreground="{ThemeResource ClWarnTextBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsOn="{x:Bind IsOn}" IsEnabled="{x:Bind CanToggle}"
                                  OnContent="Starts" OffContent="Off" Tag="{x:Bind}" Toggled="OnToggled"
                                  AutomationProperties.Name="{x:Bind ToggleName}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32,24,32,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Startup" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                       Text="The programs that start when you sign in. Turning one off stops it starting and does not uninstall it. It works the same as the Startup tab of Task Manager, and every change is recorded in Safety." />
            <TextBlock x:Name="Summary" FontSize="12" Foreground="{ThemeResource ClTextMutedBrush}" />
        </StackPanel>

        <InfoBar x:Name="Notice" Grid.Row="1" Visibility="Collapsed" IsOpen="False" Severity="Warning" IsClosable="True" />

        <Expander Grid.Row="2" Header="What is not listed here" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  AutomationProperties.Name="What is not listed here">
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource ClTextSecondaryBrush}"
                       Text="Some programs start from a scheduled task, from a service, or from a setting inside the program itself. Those are not listed, and many programs also offer their own Start with Windows option. A program turned off here can still be started by hand, and a change takes effect the next time you sign in." />
        </Expander>

        <Grid Grid.Row="3" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Search" PlaceholderText="Search startup programs" TextChanged="OnSearchChanged" AutomationProperties.Name="Search startup programs" />
            <ComboBox x:Name="FilterBox" Grid.Column="1" MinWidth="200" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Show these programs">
                <ComboBoxItem Content="All programs" Tag="All" IsSelected="True" />
                <ComboBoxItem Content="Start with Windows" Tag="On" />
                <ComboBoxItem Content="Turned off" Tag="Off" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="4">
            <ScrollViewer x:Name="ListScroll">
                <ItemsControl x:Name="List" ItemTemplate="{StaticResource StartupRowTemplate}" AutomationProperties.Name="Programs that start with Windows" />
            </ScrollViewer>
            <StackPanel x:Name="ReadingPanel" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressRing IsActive="True" Width="24" Height="24" />
                <TextBlock Text="Reading what starts with Windows" Foreground="{ThemeResource ClTextSecondaryBrush}" />
            </StackPanel>
            <TextBlock x:Name="Empty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource ClTextMutedBrush}" Text="Nothing matches." />
        </Grid>
    </Grid>
</Page>
