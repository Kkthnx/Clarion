<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Clarion.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Clarion.App.Services">

    <ScrollViewer>
        <StackPanel Padding="32,24,32,24" Spacing="18" MaxWidth="900" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Spacing="18">
                <Image Source="ms-appx:///Assets/Clarion.png" AutomationProperties.AccessibilityView="Raw" Width="72" Height="72" VerticalAlignment="Center" />
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text=".Clarion" FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                        <Border VerticalAlignment="Center" Padding="8,2,8,2" CornerRadius="10" BorderThickness="1"
                                Background="{ThemeResource ClAccentTintBrush}" BorderBrush="{ThemeResource ClAccentBrush}">
                            <TextBlock Text="{x:Bind svc:AppServices.Version}" FontSize="12" Foreground="{ThemeResource ClAccentTextBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="See it. Set it. Done." FontSize="16" Foreground="{ThemeResource ClAccentTextBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Why this app exists" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                           Text="I have been tweaking Windows for years, and every debloat tool I tried had the same problem. It changed things it could not explain, with no way back when something broke. Run it, reboot, and good luck figuring out which of the forty things it did killed your Start menu." />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                           Text=".Clarion is the tool I wanted instead. Every setting tells you what it does, what you gain, and what could go wrong. Every change gets backed up before it is made, and one click puts it back. When Windows undoes something later, .Clarion notices and tells you. No telemetry, no account, no mystery." />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Click="OnDocs" AutomationProperties.Name="Every setting explained, a website that opens in your browser">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                            <TextBlock Text="Every setting explained" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="The person behind .Clarion" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                           Text=".Clarion is made by Kkthnx, an Indiana dev who has been shipping free software for over a decade, from the KkthnxUI World of Warcraft interface to Windows utilities. The source for everything is public on GitHub." />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Click="OnWebsite" AutomationProperties.Name="Kkthnx website">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE774;" FontSize="14" />
                            <TextBlock Text="Website" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnGitHub" AutomationProperties.Name="Kkthnx on GitHub">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE77B;" FontSize="14" />
                            <TextBlock Text="GitHub" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnSource" AutomationProperties.Name=".Clarion source code on GitHub">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE943;" FontSize="14" />
                            <TextBlock Text=".Clarion source code" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnTwitch" AutomationProperties.Name="Kkthnx on Twitch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE714;" FontSize="14" />
                            <TextBlock Text="Twitch" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Support .Clarion" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                           Text=".Clarion is free, and it stays free. If it saved you a headache, a donation keeps development going." />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Style="{StaticResource AccentButtonStyle}" Click="OnPayPal" AutomationProperties.Name="Donate with PayPal, opens in your browser">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEB51;" FontSize="14" />
                            <TextBlock Text="Donate with PayPal" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource ClTextMutedBrush}"
                           Text="Donations will never be a requirement. The full app is free either way." />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Logos" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                           Text="App logos are saved inside .Clarion, so showing them sends nothing anywhere. Most are the Simple Icons set, released under CC0. Others were taken once from the program's own website or GitHub organization, or from two icon collections: Dashboard Icons (Apache-2.0) and selfh.st icons (CC BY 4.0, credited here as it asks). Where a logo was found, the address is written down in the program. A program with no logo shows its first letter. The names and logos belong to their owners. .Clarion shows them only so you can tell which app is which, and it does not mean the owners endorse .Clarion." />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <HyperlinkButton Content="Simple Icons" Click="OnSimpleIcons" Padding="0" />
                    <HyperlinkButton Content="Dashboard Icons" Click="OnDashboardIcons" Padding="0" />
                    <HyperlinkButton Content="selfh.st icons" Click="OnSelfhstIcons" Padding="0" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
