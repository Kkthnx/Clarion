<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Clarion.App.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The list is the same list every settings page uses, so search, topics, the details under each i button, the queue and the review all work the same.
         The banner above it says where the apps come from, or that winget is missing. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="WingetBar" Margin="32,16,32,0" IsOpen="False" Visibility="Collapsed" IsClosable="True" Closed="OnNoticeClosed">
            <InfoBar.ActionButton>
                <HyperlinkButton x:Name="WingetLink" Content="About winget" Click="OnWingetLink" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Updates are not part of the queue, because an update cannot be reverted. They have their own list, with nothing ticked at first. -->
        <Grid Grid.Row="1" Margin="32,12,32,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="UpdatesButton" Content="Check for app updates" Click="OnCheckUpdates"
                    ToolTipService.ToolTip="Asks winget which of your installed apps have a newer version. You choose which to update. Nothing changes until you do." />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource ClTextMutedBrush}"
                       Text="You pick which installed apps to update. An update cannot be undone from .Clarion." />
        </Grid>

        <Frame x:Name="Inner" Grid.Row="2" />
    </Grid>
</Page>
