<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Clarion.App.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The list is the same list every settings page uses, so search, topics, the details pane, the queue and the review all work the same.
         The banner above it says where the apps come from, or that winget is missing. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="WingetBar" Margin="32,16,32,0" IsOpen="False" Visibility="Collapsed" IsClosable="True" Closed="OnNoticeClosed">
            <InfoBar.ActionButton>
                <HyperlinkButton x:Name="WingetLink" Content="About winget" Click="OnWingetLink" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Frame x:Name="Inner" Grid.Row="1" />
    </Grid>
</Page>
