<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Clarion.App.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The list is the same list every settings page uses, so search, topics, the details under each i button, the queue and the review all work the same.
         The banner above it says where the apps come from, or that winget is missing. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="WingetBar" Margin="32,16,32,0" IsOpen="False" Visibility="Collapsed" IsClosable="True" Closed="OnNoticeClosed">
            <InfoBar.ActionButton>
                <HyperlinkButton x:Name="WingetLink" Content="About winget" Click="OnWingetLink" />
            </InfoBar.ActionButton>
            <InfoBar.Content>
                <Button x:Name="RepairLink" Content="Open Repair" Click="OnOpenRepair" Visibility="Collapsed" Margin="0,0,0,12" />
            </InfoBar.Content>
        </InfoBar>

        <Frame x:Name="Inner" Grid.Row="1" />

        <!-- Updates are not part of the queue, because an update cannot be reverted. They have their own list, with nothing ticked at first.
             The button sits at the right end of the page title, where there is room, so the list below it keeps its height. -->
        <Button x:Name="UpdatesButton" Grid.Row="1" Content="Check for app updates" Click="OnCheckUpdates"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,32,0"
                AutomationProperties.HelpText="You pick which installed apps to update. An update cannot be undone from .Clarion."
                ToolTipService.ToolTip="Asks winget which of your installed apps have a newer version. You choose which to update. Nothing changes until you do. An update cannot be undone from .Clarion." />
    </Grid>
</Page>
