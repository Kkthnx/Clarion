<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Clarion.App.Pages.WhatsNewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clarion.App.Controls"
    xmlns:pages="using:Clarion.App.Pages">

    <ScrollViewer>
        <StackPanel Padding="32,24,32,24" Spacing="20" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="What's new" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                           Text="What changed in each version of .Clarion, written the same way as the release notes." />
            </StackPanel>

            <!-- An update is available -->
            <Border x:Name="UpdateCard" Visibility="Collapsed" Background="{ThemeResource ClSurface1Brush}" BorderBrush="{ThemeResource ClAccentBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="0">
                <StackPanel>
                    <Border Background="{ThemeResource ClAccentTintBrush}" CornerRadius="8,8,0,0" Padding="20,16,20,16">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Image Source="ms-appx:///Assets/Clarion.png" AutomationProperties.AccessibilityView="Raw" Width="48" Height="48" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="An update is available" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                                <TextBlock x:Name="UpdateSubtitle" Foreground="{ThemeResource ClTextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Padding="20,16,20,18" Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <controls:Chip x:Name="FromChip" Kind="Neutral" VerticalAlignment="Center" />
                            <FontIcon Glyph="&#xE72A;" FontSize="14" Foreground="{ThemeResource ClTextMutedBrush}" VerticalAlignment="Center" />
                            <controls:Chip x:Name="ToChip" Kind="Accent" VerticalAlignment="Center" />
                            <TextBlock x:Name="ReleaseCount" VerticalAlignment="Center" Foreground="{ThemeResource ClTextSecondaryBrush}" />
                        </StackPanel>
                        <ItemsControl x:Name="Pills">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pages:PillVm">
                                    <controls:Chip Text="{x:Bind Text}" Kind="{x:Bind Kind}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="UpdateButtons" Orientation="Horizontal" Spacing="10">
                            <Button x:Name="UpdateNowButton" Content="Update now" Style="{StaticResource AccentButtonStyle}" Click="OnUpdateNow" />
                            <Button x:Name="OpenPageButton" Content="Open the release page" Click="OnOpenLatest" />
                            <Button x:Name="HideButton" Content="Hide this version" Click="OnHide" />
                        </StackPanel>
                        <!-- While the setup program downloads. It can be stopped, and nothing changes until the file is whole and checked. -->
                        <StackPanel x:Name="DownloadPanel" Spacing="8" Visibility="Collapsed">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="DownloadBar" Maximum="1" VerticalAlignment="Center" AutomationProperties.Name="Update download" />
                                <Button x:Name="CancelDownloadButton" Grid.Column="1" Content="Stop" Click="OnCancelDownload" />
                            </Grid>
                        </StackPanel>
                        <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{ThemeResource ClTextSecondaryBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="UpdateNote" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource ClTextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Nothing newer -->
            <StackPanel x:Name="UpToDate" Spacing="10" Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CheckButton" Content="Check for updates" Click="OnCheck" />
                    <ProgressRing x:Name="Busy" Grid.Column="1" Width="18" Height="18" IsActive="False" />
                    <TextBlock x:Name="StatusText" Grid.Column="2" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="NewerSection" Spacing="10" Visibility="Collapsed">
                <TextBlock x:Name="NewerTitle" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                <controls:ReleaseTimeline x:Name="NewerTimeline" />
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock x:Name="HistoryTitle" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                <controls:ReleaseTimeline x:Name="HistoryTimeline" />
                <Button x:Name="ShowOlder" Content="Show older releases" Click="OnShowOlder" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
