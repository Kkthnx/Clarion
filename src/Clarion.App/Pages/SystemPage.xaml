<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Clarion.App.Pages.SystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:si="using:Clarion.Core.SystemInfo"
    xmlns:pg="using:Clarion.App.Pages">

    <ScrollViewer>
        <StackPanel Padding="32,24,46,24" Spacing="20" MaxWidth="1000" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="System" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}"
                           Text="What this PC is and how your copy of Windows was put together. Nothing here is sent anywhere." />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="RefreshButton" Content="Check again" Click="OnRefresh" />
                <Button x:Name="CopyButton" Content="Copy report" Click="OnCopy" IsEnabled="False" />
                <ProgressRing x:Name="Ring" Width="20" Height="20" IsActive="True" />
                <TextBlock x:Name="StatusLabel" Text="Reading your system, this takes a few seconds." VerticalAlignment="Center"
                           Foreground="{ThemeResource ClTextMutedBrush}" />
            </StackPanel>

            <Border x:Name="InstallCard" Visibility="Collapsed" CornerRadius="8" Padding="20" BorderThickness="1"
                    Background="{ThemeResource ClSurface1Brush}" BorderBrush="{ThemeResource ClBorderBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Windows install check" FontSize="13" Foreground="{ThemeResource ClTextMutedBrush}" />
                    <TextBlock x:Name="Headline" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                    <TextBlock x:Name="Explanation" TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}" />
                    <ItemsControl x:Name="Signals">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="si:InstallSignal">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,2">
                                    <TextBlock Text="&#x2022;" Foreground="{ThemeResource ClAccentBrush}" />
                                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border x:Name="UpdateCard" Visibility="Collapsed" CornerRadius="8" Padding="20" BorderThickness="1"
                    Background="{ThemeResource ClSurface1Brush}" BorderBrush="{ThemeResource ClBorderBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Windows Update right now" FontSize="13" Foreground="{ThemeResource ClTextMutedBrush}" />
                    <TextBlock x:Name="UpdateHeadline" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                    <TextBlock x:Name="UpdateExplanation" TextWrapping="Wrap" Foreground="{ThemeResource ClTextSecondaryBrush}" />
                    <ItemsControl x:Name="UpdateFindings">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pg:UpdateRow">
                                <Grid ColumnSpacing="10" Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Mark}" Foreground="{x:Bind MarkBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Text}" TextWrapping="Wrap" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ItemsControl x:Name="Groups">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="si:FactGroup">
                        <Border Margin="0,0,0,16" CornerRadius="8" Padding="20" BorderThickness="1"
                                Background="{ThemeResource ClSurface1Brush}" BorderBrush="{ThemeResource ClBorderBrush}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource ClTextPrimaryBrush}" />
                                <ItemsControl ItemsSource="{x:Bind Facts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="si:Fact">
                                            <Grid ColumnSpacing="16" Margin="0,3,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Label}" Foreground="{ThemeResource ClTextMutedBrush}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                           Foreground="{ThemeResource ClTextPrimaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
